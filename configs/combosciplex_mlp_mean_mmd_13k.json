    "gradient_clip": {
      "flow": 1.0,
      "decoder": 1.0,
      "head": 1.0
    },
    "schedule": {
      "type": "cosine",
      "start": 500,
      "end": 13000,
      "min_factor": 0.1
    },
    "checkpoint_every": 500,
    "log_every": 10,
    "monitor_every": 50,
    "cpu_threads": 2
  },
  "mean_head": {
    "kernel": "canonical_pair_concat_MAPKG_RBF_Morgan_Tanimoto",
    "selection": "leave_one_training_combination_out",
    "kg_mix_grid": [
      0.0,
      0.5,
      1.0
    ],
    "gamma_factor_grid": [
      0.5,
      1.0,
      2.0
    ],
    "alpha_grid": [
      0.001,
      0.01,
      0.1,
      1.0,
      10.0
    ],
    "selection_metric": "delta_mse_2000_genes",
    "morgan_radius": 2,
    "morgan_bits": 2048
  },
  "evaluation": {
    "mean_every": 500,
    "mean_seeds": [
      4243
    ],
    "full_every": 1000,
    "monitor_seeds": [
      4243
    ],
    "final_four_seeds": true,
    "time_points": 80,
    "precision": "fp32",
    "cells": 128,
    "allow_tf32": false,
    "evaluation_overhead_target": 0.1
