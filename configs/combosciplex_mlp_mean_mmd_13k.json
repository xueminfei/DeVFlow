    "loss_weights": {
      "flow_residual": 1.0,
      "flow_mean": 32.0,
      "decoder_mmd": 1.0,
      "head": 1.0
    }
  },
  "training": {
    "checkpoint": null,
    "max_updates": 13000,
    "world_size": 4,
    "seed": 42,
    "precision": "bf16",
    "allow_tf32": true,
    "pairs_per_condition": 256,
