    "seeds": [
      4243,
      4244,
      4245,
      4246
    ],
    "cells": 128,
    "time_points": 80,
    "chunk": 128,
    "device": "cuda:0"
  },
  "selection": {
    "protocol": "external_selected_exploratory",
    "primary_metric": "weighted_mse",
    "direction": "min",
    "tie_break": "earliest_update",
    "benchmark_selected": true,
    "single_checkpoint_for_all_reported_metrics": true
